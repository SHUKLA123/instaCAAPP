# Copy to .env and fill in. Never commit the real .env (react-native-config).

# Base URL of the InstaCA Go API, no trailing slash.
API_BASE_URL=https://instaca-api.onrender.com

# WebSocket URL for /v1/ws (wss:// in prod). Same host, ws scheme.
WS_BASE_URL=wss://instaca-api.onrender.com

# Agora App ID (audio-only project). Token is minted server-side per session
# via GET /v1/consult/sessions/{id}/call-token — no Agora secret lives in the app.
AGORA_APP_ID=

# Razorpay key id (public, safe for client). The key secret never goes in the app.
RAZORPAY_KEY_ID=

# Default GST rate shown as a fallback before the API responds, as a percentage.
DEFAULT_GST_RATE_PERCENT=18
